                      </span>
                    </div>
                    {item.type === "file" && (
                      <span className="text-xs px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/40">
                        Watch
                      </span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        ) : list.length === 0 ? (
          /* Empty or Fallback to Direct Mirror */
          <div className="text-center py-20 border border-emerald-950/80 rounded-2xl bg-[#04170E]/40 p-8 max-w-lg mx-auto">
            <h3 className="text-lg font-bold text-emerald-400 mb-2">{p?.name || "Platform"} Batches</h3>
            <p className="text-sm text-zinc-400 mb-6">
              LearnX direct player gateway ke zariye batches aur content access karein.
            </p>
            {p?.mirrors?.[0]?.url && (
              <Button
                onClick={() => setIframeUrl(p.mirrors[0].url)}
                className="bg-emerald-500 hover:bg-emerald-400 text-black font-bold"
              >
                Open LearnX Classroom Gateway <ExternalLink className="w-4 h-4 ml-2" />
              </Button>
            )}
          </div>
        ) : (
          /* Batches Grid */
          <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {list.map((b) => (
              <div
                key={b.id}
                onClick={() => handleBatchClick(b)}
                className="rounded-xl border border-emerald-950/70 bg-[#04170E]/50 overflow-hidden hover:border-emerald-500/50 hover:shadow-[0_0_20px_rgba(34,197,94,0.15)] transition cursor-pointer group flex flex-col justify-between"
              >
                <div>
                  <div className="aspect-video bg-black/60 overflow-hidden relative">
                    {b.thumbnail ? (
                      <img src={b.thumbnail} alt={b.title} className="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    ) : (
                      <div className="w-full h-full flex items-center justify-center text-emerald-700 font-mono text-xs">
                        [ NO THUMBNAIL ]
                      </div>
                    )}
                  </div>
                  <div className="p-3">
                    <h3 className="font-semibold text-sm text-zinc-200 group-hover:text-emerald-300 line-clamp-2">
                      {b.title}
                    </h3>
                  </div>
                </div>
                <div className="p-3 pt-0">
                  <Button size="sm" className="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold h-8 text-xs">
                    {isApiPlatform ? "Open Lectures" : "Start Watching (LearnX)"}
                  </Button>
                </div>
              </div>
            ))}
          </div>
        )}
      </main>

      {/* CyberPlayer Modal (For Direct Streams: NT, SW, VB, MS) */}
      {playerStream && (
        <div className="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
          <div className="w-full max-w-4xl bg-[#04170E] border border-emerald-900 rounded-2xl overflow-hidden shadow-2xl">
            <CyberPlayer
              src={playerStream.url}
              title={playerStream.title}
              onBack={() => setPlayerStream(null)}
            />
          </div>
        </div>
      )}

      {/* LearnX Direct Iframe Modal (PW, PI, UA, RWA etc. — NO BEE PROXY) */}
      {iframeUrl && (
        <div className="fixed inset-0 z-50 bg-black/95 flex flex-col">
          <div className="p-3 bg-[#04170E] border-b border-emerald-950 flex items-center justify-between">
            <span className="text-sm font-semibold text-emerald-400 flex items-center gap-2">
              🟢 LearnX Direct Gateway Player
            </span>
            <Button size="sm" variant="ghost" onClick={() => setIframeUrl(null)} className="text-zinc-400 hover:text-white">
              <X className="w-5 h-5" />
            </Button>
          </div>
          <iframe
            src={iframeUrl}
            className="w-full flex-1 border-0"
            allow="fullscreen; autoplay; clipboard-write; encrypted-media"
          />
        </div>
      )}
    </div>
  );
}
