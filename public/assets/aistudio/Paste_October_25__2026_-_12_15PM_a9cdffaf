Prepared custom video player code for HLS and MP4
Bhai, ye raha HLS CyberPlayer aur direct API stream ka complete code jo aap direct apne VS Code me laga sakte hain:

Step 1: src/components/CyberPlayer.tsx
Yeh in-house player direct .m3u8 aur .mp4 video streams ko play karega (bina kisi third-party website ya iframe block ke). Isme Quality (Auto/1080p/720p/360p), Speed (0.5x–2x), Fullscreen aur ±10s skip controls hain:

import { useEffect, useRef, useState } from "react";
import { Maximize, Pause, Play, Radio, RotateCcw, RotateCw, Volume2, VolumeX } from "lucide-react";

type HlsLevel = { height?: number };
type HlsInstance = {
  loadSource: (url: string) => void;
  attachMedia: (media: HTMLMediaElement) => void;
  destroy: () => void;
  on: (event: string, callback: (...args: unknown[]) => void) => void;
  levels?: HlsLevel[];
  currentLevel?: number;
};
type HlsConstructor = {
  new (config?: Record<string, unknown>): HlsInstance;
  isSupported: () => boolean;
  Events: { MANIFEST_PARSED: string; ERROR: string };
};
declare global {
  interface Window { Hls?: HlsConstructor }
}

interface CyberPlayerProps {
  src: string;
  title: string;
  isLive?: boolean;
  poster?: string;
  onBack?: () => void;
}

function isHls(src: string) { return /\.m3u8(?:$|[?#])/i.test(src); }

export function CyberPlayer({ src, title, isLive = false, poster, onBack }: CyberPlayerProps) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const boxRef = useRef<HTMLDivElement>(null);
  const hlsRef = useRef<HlsInstance | null>(null);
  const [playing, setPlaying] = useState(false);
  const [muted, setMuted] = useState(false);
  const [speed, setSpeed] = useState(1);
  const [qualityList, setQualityList] = useState<{ id: number; height: number }[]>([]);
  const [quality, setQuality] = useState(-1);
  const [time, setTime] = useState(0);
  const [duration, setDuration] = useState(0);
  const [error, setError] = useState("");

  useEffect(() => {
    const video = videoRef.current;
    if (!video || !src) return;
    let cancelled = false;
    let script: HTMLScriptElement | null = null;
    const cleanup = () => { hlsRef.current?.destroy(); hlsRef.current = null; };
    setError(""); setQualityList([]); setQuality(-1); setPlaying(false);

    const attachHls = (Hls: HlsConstructor) => {
      if (cancelled) return;
      if (!Hls.isSupported()) { setError("Is browser mein HLS playback support nahi hai."); return; }
      cleanup();
      const hls = new Hls({ enableWorker: true, lowLatencyMode: isLive });
      hlsRef.current = hls;
      hls.on(Hls.Events.MANIFEST_PARSED, () => {
        setQualityList((hls.levels ?? []).map((level, id) => ({ id, height: level.height ?? 0 })).filter((item) => item.height > 0));
      });
      hls.on(Hls.Events.ERROR, (...args: unknown[]) => {
        const detail = args[1] as { fatal?: boolean; type?: string } | undefined;
        if (detail?.fatal) setError("Stream load nahi hui. Link expire, provider access, ya stream server check karein.");
      });
      hls.loadSource(src);
      hls.attachMedia(video);
    };

    if (isHls(src) && !video.canPlayType("application/vnd.apple.mpegurl")) {
      if (window.Hls) attachHls(window.Hls);
      else {
        script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/hls.js@1.5.20/dist/hls.min.js";
        script.async = true;
        script.onload = () => { if (window.Hls) attachHls(window.Hls); else setError("HLS player load nahi hua."); };
        script.onerror = () => setError("HLS player download nahi ho paya. Internet check karein.");
        document.head.appendChild(script);
      }
    } else {
      video.src = src;
      video.load();
    }
    return () => {
      cancelled = true; cleanup();
      if (script?.parentNode) script.parentNode.removeChild(script);
      video.pause(); video.removeAttribute("src"); video.load();
    };
  }, [src, isLive]);

  useEffect(() => { if (videoRef.current) videoRef.current.muted = muted; }, [muted]);
  const togglePlay = async () => {
    const video = videoRef.current; if (!video) return;
    if (video.paused) { try { await video.play(); setError(""); } catch { setError("Playback start nahi hua; dobara Play dabao."); } }
    else video.pause();
  };
  const skip = (amount: number) => {
    const video = videoRef.current;
    if (video && Number.isFinite(video.duration)) video.currentTime = Math.max(0, Math.min(video.duration, video.currentTime + amount));
  };
  const changeSpeed = (next: number) => { setSpeed(next); if (videoRef.current) videoRef.current.playbackRate = next; };
  const changeQuality = (next: number) => { setQuality(next); if (hlsRef.current) hlsRef.current.currentLevel = next; };
  const fullscreen = () => {
    if (!boxRef.current) return;
    if (document.fullscreenElement) void document.exitFullscreen().catch(() => {});
    else void boxRef.current.requestFullscreen().catch(() => {});
  };
  const formatTime = (value: number) => {
    if (!Number.isFinite(value)) return "0:00";
    const mins = Math.floor(value / 60); const secs = Math.floor(value % 60);
    return `${mins}:${String(secs).padStart(2, "0")}`;
  };

  return (
    <div ref={boxRef} className="relative aspect-video w-full overflow-hidden rounded-lg border border-primary/40 bg-[#020604] text-white shadow-2xl">
      <video ref={videoRef} poster={poster} playsInline className="h-full w-full object-contain" onTimeUpdate={() => { const video = videoRef.current; if (video) { setTime(video.currentTime); setDuration(video.duration || 0); } }} onPlay={() => setPlaying(true)} onPause={() => setPlaying(false)} onError={() => setError("Video play nahi hui; stream URL expire ya unavailable ho sakti hai.")} />
      <div className="absolute inset-x-0 top-0 flex items-center justify-between gap-2 bg-gradient-to-b from-black/90 to-transparent p-3">
        <div className="flex min-w-0 items-center gap-2">
          {onBack && <button onClick={onBack} className="shrink-0 rounded border border-primary/50 bg-black/60 px-2.5 py-1 text-xs font-mono text-primary">← BACK</button>}
          <span className="truncate text-sm font-bold font-mono text-primary">{title}</span>
        </div>
        {isLive && <span className="flex shrink-0 items-center gap-1 rounded bg-red-600 px-2 py-1 text-[10px] font-bold tracking-wider"><Radio className="h-3 w-3" /> LIVE</span>}
      </div>
      {error && <div role="status" className="absolute inset-x-3 top-14 rounded-lg border border-amber-400/50 bg-black/90 p-3 text-sm">{error}</div>}
      <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/95 via-black/70 to-transparent p-3">
        {!isLive && duration > 0 && <div className="mb-2 flex items-center gap-2 text-[10px] font-mono"><span>{formatTime(time)}</span><input aria-label="Video progress" type="range" min={0} max={duration} value={time} onChange={(e) => { const next = Number(e.target.value); setTime(next); if (videoRef.current) videoRef.current.currentTime = next; }} className="h-1 min-w-0 flex-1 accent-[#22c55e]" /><span>{formatTime(duration)}</span></div>}
        <div className="flex items-center justify-between gap-2 font-mono text-xs">
          <div className="flex items-center gap-2">
            <button aria-label={playing ? "Pause" : "Play"} onClick={() => void togglePlay()} className="text-primary">{playing ? <Pause className="h-5 w-5" /> : <Play className="h-5 w-5 fill-current" />}</button>
            {!isLive && <><button aria-label="Back 10 seconds" onClick={() => skip(-10)}><RotateCcw className="h-4 w-4" /></button><button aria-label="Forward 10 seconds" onClick={() => skip(10)}><RotateCw className="h-4 w-4" /></button></>}
            <button aria-label={muted ? "Unmute" : "Mute"} onClick={() => setMuted(!muted)}>{muted ? <VolumeX className="h-4 w-4" /> : <Volume2 className="h-4 w-4" />}</button>
          </div>
          <div className="flex items-center gap-2">
            <select aria-label="Playback speed" value={speed} onChange={(e) => changeSpeed(Number(e.target.value))} className="max-w-[70px] rounded border border-primary/30 bg-black/90 px-1.5 py-1 text-primary">{[0.5, 0.75, 1, 1.25, 1.5, 2].map((value) => <option key={value} value={value}>{value}x</option>)}</select>
            {qualityList.length > 0 && <select aria-label="Stream quality" value={quality} onChange={(e) => changeQuality(Number(e.target.value))} className="max-w-[82px] rounded border border-primary/30 bg-black/90 px-1.5 py-1 text-primary"><option value={-1}>Auto</option>{qualityList.map((item) => <option key={item.id} value={item.id}>{item.height}p</option>)}</select>}
            <button aria-label="Fullscreen" onClick={fullscreen}><Maximize className="h-4 w-4" /></button>
          </div>
        </div>
      </div>
    </div>
  );
}
