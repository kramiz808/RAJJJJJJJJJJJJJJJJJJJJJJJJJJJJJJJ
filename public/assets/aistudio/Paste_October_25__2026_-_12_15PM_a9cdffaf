import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { beeOrigin, isBeeHost } from "@/lib/platforms";

export type Batch = { 
  id: string; 
  title: string; 
  thumbnail: string; 
  platform?: string;
  hasApi?: boolean;
};

export type ContentItem = {
  id: string;
  type: "folder" | "file";
  title: string;
  thumbnail?: string;
  duration?: number;
  streamUrl?: string;
  isPdf?: boolean;
};

const NT_KEY = "sumit405060";
const cache = new Map<string, { at: number; data: any }>();

/** 1. Platform Batches Fetcher */
export const getBatches = createServerFn({ method: "GET" })
  .inputValidator((d) =>
    z.object({
      host: z.string(),
      base: z.string().optional(),
      platformId: z.string().optional(),
    }).parse(d),
  )
  .handler(async ({ data }) => {
    const pId = data.platformId || data.host;
    const cacheKey = `batches:${pId}`;
    const hit = cache.get(cacheKey);
    if (hit && Date.now() - hit.at < 5 * 60e3) return hit.data as Batch[];

    // --- A. Next Toppers (NT Live API) ---
