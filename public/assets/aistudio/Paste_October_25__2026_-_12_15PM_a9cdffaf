interface CyberPlayerProps {
  src: string;
  title: string;
  isLive?: boolean;
  onBack?: () => void;
}

export function CyberPlayer({ src, title, isLive = false, onBack }: CyberPlayerProps) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const [playing, setPlaying] = useState(false);
  const [muted, setMuted] = useState(false);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [speed, setSpeed] = useState(1);
  const [qualityList, setQualityList] = useState<{ id: number; height: number }[]>([]);
  const [currentQuality, setCurrentQuality] = useState<number>(-1);
  const hlsInstance = useRef<any>(null);

  useEffect(() => {
    let destroyed = false;
    setError(null);
    setLoading(true);

    const initPlayer = () => {
      const video = videoRef.current;
      if (!video) return;

      if (src.includes(".m3u8")) {
        const loadHls = () => {
          if (window.Hls && window.Hls.isSupported()) {
            if (hlsInstance.current) hlsInstance.current.destroy();

            const hls = new window.Hls({
              enableWorker: true,
              lowLatencyMode: isLive,
            });
            hlsInstance.current = hls;

            hls.loadSource(src);
            hls.attachMedia(video);

            hls.on(window.Hls.Events.MANIFEST_PARSED, (_: any, data: any) => {
              if (destroyed) return;
              setLoading(false);
              const levels = data.levels.map((lvl: any, idx: number) => ({
                id: idx,
                height: lvl.height,
              }));
              setQualityList(levels);
              video.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
            });

            hls.on(window.Hls.Events.ERROR, (_: any, data: any) => {
              if (data.fatal) {
                setError("Stream load karne me dikkat aayi. Source server check karein.");
                setLoading(false);
              }
            });
          } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
            video.src = src;
            video.addEventListener("loadedmetadata", () => {
              setLoading(false);
              video.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
            });
          } else {
            setError("Aapka browser HLS (.m3u8) playback support nahi karta.");
            setLoading(false);
          }
        };

        if (!window.Hls) {
          const script = document.createElement("script");
          script.src = "https://cdn.jsdelivr.net/npm/hls.js@latest";
          script.onload = loadHls;
          document.head.appendChild(script);
        } else {
          loadHls();
        }
      } else {
        video.src = src;
        video.addEventListener("loadeddata", () => setLoading(false));
        video.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
      }
    };

    initPlayer();

    return () => {
      destroyed = true;
      if (hlsInstance.current) {
        hlsInstance.current.destroy();
        hlsInstance.current = null;
      }
    };
  }, [src, isLive]);

  const togglePlay = () => {
    if (!videoRef.current) return;
    if (playing) {
      videoRef.current.pause();
      setPlaying(false);
    } else {
      videoRef.current.play();
      setPlaying(true);
    }
  };

  const toggleMute = () => {
    if (!videoRef.current) return;
    videoRef.current.muted = !muted;
    setMuted(!muted);
  };

  const changeSpeed = () => {
    if (!videoRef.current) return;
    const speeds = [1, 1.25, 1.5, 2];
    const next = speeds[(speeds.indexOf(speed) + 1) % speeds.length];
    videoRef.current.playbackRate = next;
    setSpeed(next);
  };

  const seek = (seconds: number) => {
